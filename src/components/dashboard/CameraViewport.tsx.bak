import React, { useState, useRef, useEffect } from 'react';
import { useDetection } from '../../context/DetectionContext';
import { DetectionOverlay } from './DetectionOverlay';
import { soundEffects } from '../../utils/soundEffects';
import { 
  Camera, 
  Video, 
  Maximize2, 
  Radio, 
  Scan, 
  Layers, 
  Crosshair, 
  Eye, 
  Sparkles,
  AlertCircle,
  Film
} from 'lucide-react';

interface CameraViewportProps {
  onFullscreenToggle: () => void;
}

export const CameraViewport: React.FC<CameraViewportProps> = ({ onFullscreenToggle }) => {
  const { 
    objects, 
    settings, 
    selectedTrackId, 
    setSelectedTrackId, 
    cameraActive, 
    stats,
    activeFilter,
    videoSource,
    setVideoSource
  } = useDetection();

  const [isWebcamActive, setIsWebcamActive] = useState<boolean>(false);
  const [webcamError, setWebcamError] = useState<string | null>(null);
  const videoRef = useRef<HTMLVideoElement>(null);

  // Switch to real webcam feed safely
  const toggleWebcam = async () => {
    soundEffects.playClick();
    if (isWebcamActive) {
      if (videoRef.current && videoRef.current.srcObject) {
        const stream = videoRef.current.srcObject as MediaStream;
        stream.getTracks().forEach((track) => track.stop());
        videoRef.current.srcObject = null;
      }
      setIsWebcamActive(false);
      setVideoSource('mock-cyber');
    } else {
      try {
        setWebcamError(null);
        const stream = await navigator.mediaDevices.getUserMedia({
          video: { width: { ideal: 1280 }, height: { ideal: 720 } },
          audio: false,
        });
        if (videoRef.current) {
          videoRef.current.srcObject = stream;
          videoRef.current.play();
        }
        setIsWebcamActive(true);
        setVideoSource('webcam');
      } catch (err) {
        console.warn('Webcam permission not granted or camera not available:', err);
        setWebcamError('Camera unavailable or permission denied. Showing simulated feed.');
        setTimeout(() => setWebcamError(null), 4000);
      }
    }
  };

  useEffect(() => {
    return () => {
      if (videoRef.current && videoRef.current.srcObject) {
        const stream = videoRef.current.srcObject as MediaStream;
        stream.getTracks().forEach((track) => track.stop());
      }
    };
  }, []);

  return (
    <div className="relative w-full h-full flex flex-col glass-panel-elevated rounded-2xl overflow-hidden border border-cyan-500/30 shadow-[0_12px_40px_rgba(0,0,0,0.8)]">
      {/* 3D Corner Accent Brackets */}
      <div className="corner-bracket-tl" />
      <div className="corner-bracket-tr" />
      <div className="corner-bracket-bl" />
      <div className="corner-bracket-br" />

      {/* Top Viewport Telemetry Header */}
      <div className="px-5 py-2.5 bg-slate-950/70 border-b border-cyan-500/20 flex items-center justify-between z-30">
        <div className="flex items-center gap-3">
          <div className="flex items-center gap-1.5 px-2.5 py-1 rounded bg-cyan-950/60 border border-cyan-500/30 text-cyan-300 font-mono text-xs">
            <Scan className="w-3.5 h-3.5 text-cyan-400 animate-spin" style={{ animationDuration: '6s' }} />
            <span>OPTICAL MATRIX HUD</span>
          </div>

          <div className="hidden sm:flex items-center gap-2 text-xs font-mono text-slate-400">
            <span>RES: {stats.resolution}</span>
            <span>•</span>
            <span className="text-emerald-400">COLOR: RGB-D</span>
          </div>
        </div>

        {/* Viewport Source Selectors */}
        <div className="flex items-center gap-2">
          {/* Feed Source Mode Pills */}
          <div className="flex items-center bg-slate-900/80 p-1 rounded-lg border border-slate-800 text-xs font-mono">
            <button
              onClick={() => {
                soundEffects.playClick();
                if (isWebcamActive && videoRef.current?.srcObject) {
                  const stream = videoRef.current.srcObject as MediaStream;
                  stream.getTracks().forEach((t) => t.stop());
                  setIsWebcamActive(false);
                }
                setVideoSource('mock-cyber');
              }}
              className={`px-2.5 py-1 rounded transition-all cursor-pointer ${
                videoSource === 'mock-cyber'
                  ? 'bg-cyan-500/20 text-cyan-300 border border-cyan-500/40 font-semibold'
                  : 'text-slate-400 hover:text-slate-200'
              }`}
            >
              SIMULATION
            </button>
            <button
              onClick={toggleWebcam}
              className={`px-2.5 py-1 rounded flex items-center gap-1.5 transition-all cursor-pointer ${
                isWebcamActive
                  ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 font-semibold'
                  : 'text-slate-400 hover:text-slate-200'
              }`}
            >
              <Camera className="w-3 h-3" />
              <span>LIVE CAM</span>
            </button>
          </div>

          {/* Fullscreen icon */}
          <button
            onClick={() => {
              soundEffects.playClick();
              onFullscreenToggle();
            }}
            className="p-1.5 rounded-lg bg-slate-900/60 border border-slate-700 hover:border-cyan-400 text-slate-300 hover:text-cyan-300 cursor-pointer transition-colors"
            title="Expand Viewport"
          >
            <Maximize2 className="w-3.5 h-3.5" />
          </button>
        </div>
      </div>

      {/* Main Visual Display Stage */}
      <div className="relative flex-1 bg-[#02050e] overflow-hidden flex items-center justify-center min-h-[380px] lg:min-h-[460px]">
        {/* Animated Laser Scanning Line */}
        {cameraActive && <div className="laser-scanner z-20" />}

        {/* Scanline CRT overlay */}
        <div className="absolute inset-0 scanlines z-10 pointer-events-none" />

        {/* Video / Synthetic Feed Scene */}
        {isWebcamActive ? (
          <video
            ref={videoRef}
            autoPlay
            playsInline
            muted
            className="w-full h-full object-cover z-0"
          />
        ) : (
          /* Futuristic Simulated AI Camera Scene */
          <div className="relative w-full h-full bg-gradient-to-b from-[#060b19] via-[#040814] to-[#020409] flex items-center justify-center overflow-hidden">
            {/* Ambient Cyber Grid Matrix Backdrop */}
            <div 
              className="absolute inset-0 opacity-25"
              style={{
                backgroundImage: `
                  radial-gradient(circle at 50% 50%, rgba(0, 243, 255, 0.15) 0%, transparent 60%),
                  linear-gradient(to right, rgba(0, 243, 255, 0.08) 1px, transparent 1px),
                  linear-gradient(to bottom, rgba(0, 243, 255, 0.08) 1px, transparent 1px)
                `,
                backgroundSize: '100% 100%, 40px 40px, 40px 40px',
              }}
            />

            {/* Synthetic Silhouette: Person (ID: 01) */}
            <div 
              className="absolute transition-all duration-300 flex flex-col items-center justify-center opacity-85"
              style={{
                left: '28%',
                top: '22%',
                width: '18%',
                height: '58%',
              }}
            >
              {/* Silhouette Vector / Cyber Body */}
              <div className="w-10 h-10 rounded-full bg-gradient-to-b from-cyan-400/40 to-cyan-700/20 border border-cyan-400/50 shadow-[0_0_20px_rgba(0,243,255,0.3)] mb-1" />
              <div className="w-20 h-36 rounded-2xl bg-gradient-to-b from-cyan-500/20 to-slate-900/60 border border-cyan-400/30 backdrop-blur-xs relative">
                <div className="absolute inset-x-2 top-3 h-1 bg-cyan-400/40 rounded-full" />
                <div className="absolute inset-x-4 top-8 h-1 bg-cyan-400/20 rounded-full" />
                <div className="absolute inset-x-3 bottom-6 h-12 border-t border-cyan-500/30" />
              </div>
            </div>

            {/* Synthetic Silhouette: Vehicle / Cyber Car (ID: 02) */}
            <div
              className="absolute transition-all duration-300 opacity-80"
              style={{
                left: '64%',
                top: '42%',
                width: '24%',
                height: '34%',
              }}
            >
              <div className="w-full h-full rounded-2xl bg-gradient-to-r from-purple-950/40 via-purple-900/30 to-slate-900/60 border border-purple-400/40 p-3 flex flex-col justify-between shadow-[0_0_25px_rgba(168,85,247,0.2)]">
                <div className="flex justify-between items-center">
                  <span className="text-[10px] font-mono text-purple-300">AUTONOMOUS UNIT</span>
                  <div className="flex gap-1">
                    <span className="w-2 h-2 rounded-full bg-purple-400 animate-ping" />
                    <span className="w-2 h-2 rounded-full bg-purple-400" />
                  </div>
                </div>
                <div className="h-4 bg-purple-500/20 rounded border border-purple-400/30 flex items-center px-2">
                  <div className="w-full h-1 bg-gradient-to-r from-purple-400 to-transparent rounded" />
                </div>
              </div>
            </div>

            {/* Synthetic Object: Bottle / Sensor Container (ID: 03) */}
            <div
              className="absolute transition-all duration-300 opacity-85"
              style={{
                left: '13.5%',
                top: '56%',
                width: '6%',
                height: '22%',
              }}
            >
              <div className="w-full h-full rounded-xl bg-emerald-950/40 border border-emerald-400/50 p-1 flex flex-col items-center justify-between shadow-[0_0_15px_rgba(16,185,129,0.3)]">
                <div className="w-3 h-2 bg-emerald-400/60 rounded-t" />
                <div className="w-full flex-1 bg-emerald-500/10 rounded flex items-center justify-center">
                  <div className="w-1.5 h-6 bg-emerald-400/40 rounded-full" />
                </div>
              </div>
            </div>

            {/* Center HUD Reticle */}
            <div className="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 pointer-events-none opacity-30">
              <Crosshair className="w-24 h-24 text-cyan-400 animate-pulse-slow" />
            </div>
          </div>
        )}

        {/* AR Computer-Vision Bounding Boxes Overlay */}
        {cameraActive && (
          <DetectionOverlay
            objects={objects}
            settings={settings}
            selectedTrackId={selectedTrackId}
            onSelectTrack={setSelectedTrackId}
            activeFilter={activeFilter}
          />
        )}

        {/* Camera Inactive Notification Screen */}
        {!cameraActive && (
          <div className="absolute inset-0 bg-black/85 backdrop-blur-md flex flex-col items-center justify-center z-30">
            <Radio className="w-12 h-12 text-slate-600 mb-3 animate-pulse" />
            <span className="font-orbitron font-semibold text-lg text-slate-400">
              VIDEO FEED SUSPENDED
            </span>
            <span className="font-mono text-xs text-slate-600 mt-1">
              CLICK 'CAMERA' OR 'START DETECTION' TO RESUME
            </span>
          </div>
        )}

        {/* Notification Toast if Camera Warning */}
        {webcamError && (
          <div className="absolute top-4 left-1/2 -translate-x-1/2 px-4 py-2 bg-amber-950/90 border border-amber-500/60 rounded-xl text-amber-200 text-xs font-mono flex items-center gap-2 z-40 shadow-xl backdrop-blur-md">
            <AlertCircle className="w-4 h-4 text-amber-400" />
            <span>{webcamError}</span>
          </div>
        )}
      </div>

      {/* Viewport Bottom Status Bar */}
      <div className="px-5 py-2 bg-slate-950/80 border-t border-cyan-500/20 flex items-center justify-between text-[11px] font-mono text-slate-400 z-30">
        <div className="flex items-center gap-4">
          <span className="flex items-center gap-1 text-cyan-300">
            <span className="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-ping" />
            TARGET TRACKING: ACTIVE
          </span>
          <span className="hidden md:inline">INFERENCE: {stats.inferenceTimeMs}ms</span>
        </div>

        <div className="flex items-center gap-4">
          <span className="text-purple-300">TRACKS LOCK: {objects.length}</span>
          <span className="text-emerald-400">FPS: {stats.fps}</span>
        </div>
      </div>
    </div>
  );
};
